# Munchkin — variáveis de ambiente locais de exemplo.
# Nenhum segredo real aqui. Copie para .env e ajuste:  cp .env.example .env
#
# Este arquivo cresce a cada checkpoint. Hoje cobre o CP-00/CP-01.

# --- Aplicação -------------------------------------------------------------
APP_ENV=local                  # local | test | production
HTTP_PORT=8080                 # porta em que a aplicação escuta
API_HOST_PORT=8080             # porta publicada na sua máquina pelo compose
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_REQUEST_TIMEOUT=10s       # deadline propagado no context de cada request
HTTP_SHUTDOWN_TIMEOUT=20s      # prazo para drenar requisições em andamento

# --- Observabilidade -------------------------------------------------------
LOG_LEVEL=info                 # debug | info | warn | error
LOG_FORMAT=json                # json em qualquer ambiente; text só para depurar à mão

# --- Autenticação (IdP externo OIDC) --------------------------------------
# AUTH_ISSUER é o valor esperado na claim `iss` do token. Obrigatório: sem ele
# a aplicação não sobe, porque um serviço que não sabe em qual IdP confiar
# aceitaria tráfego sem conseguir validar credencial.
AUTH_ISSUER=http://localhost:8180/realms/munchkin
AUTH_AUDIENCE=munchkin-api

# Quando a aplicação roda dentro da rede do compose, ela alcança o Keycloak
# por um endereço interno, enquanto o token continua sendo emitido com o
# endereço público. Nesse caso, aponte a descoberta para o endereço interno:
# AUTH_DISCOVERY_URL=http://keycloak:8080/realms/munchkin/.well-known/openid-configuration
AUTH_DISCOVERY_URL=

# Período do ticker que acompanha rotação programada de chave.
AUTH_JWKS_REFRESH_INTERVAL=15m
# Intervalo mínimo entre atualizações forçadas por `kid` desconhecido. Protege
# o IdP de uma enxurrada de tokens forjados com kid aleatório.
AUTH_JWKS_MIN_REFRESH_INTERVAL=1m
AUTH_HTTP_TIMEOUT=5s

# --- Keycloak (apenas ambiente local) --------------------------------------
KEYCLOAK_PORT=8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- PostgreSQL ------------------------------------------------------------
# A aplicação conecta como munchkin_app, que NÃO é dono do schema. A separação
# é o que permite impor imutabilidade no banco: o dono de uma tabela tem
# privilégio por ownership, e revogar UPDATE/DELETE dele não teria efeito.
DB_HOST=localhost
DB_PORT=5440
DB_NAME=munchkin
DB_USER=munchkin_app
DB_PASSWORD=local-only-app
DB_SSLMODE=disable

# Pool. O padrão de conexões abertas é baixo de propósito: o enunciado exige
# demonstrar as garantias com pelo menos três processos independentes, e três
# instâncias generosas esgotariam o max_connections padrão do PostgreSQL.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s

# Dono do schema — usado pelas migrations e pelo provisionamento, nunca pela
# aplicação. Apenas ambiente local.
DB_HOST_PORT=5440
DB_OWNER_USER=munchkin_owner
DB_OWNER_PASSWORD=local-only-owner

# --- Processos de fundo -----------------------------------------------------
# Frequência da varredura de reversões aguardando sua referência. Curto o
# bastante para resolver rápido quando a referência chega, longo o bastante para
# não transformar a fila vazia num laço de consultas.
WORKER_REFERENCE_INTERVAL=5s

# Varredura da outbox. Mais curta que a de referências: o evento já existe e
# está apenas esperando transporte, então o atraso aqui é atraso de integração.
WORKER_OUTBOX_INTERVAL=2s

# Quantos eventos uma rodada reivindica. Lote grande economiza ida ao banco e
# prende mais registros se o processo morrer no meio.
WORKER_OUTBOX_BATCH=50

# Por quanto tempo uma instância detém um evento reivindicado. Maior que uma
# publicação com folga, menor que a espera aceitável quando uma instância morre.
WORKER_OUTBOX_LEASE=30s

# ---------------------------------------------------------------------------
# AWS / SQS
# ---------------------------------------------------------------------------
# Em desenvolvimento apontamos para o LocalStack. AWS_ENDPOINT_URL vazio faz o
# SDK resolver o endereço real do serviço, que é o comportamento de produção.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566

# Credenciais do LocalStack: qualquer valor não vazio serve, e nenhum é secreto.
# Em produção estas variáveis vêm do provedor de identidade da infraestrutura.
AWS_ACCESS_KEY_ID=local-only-access-key
AWS_SECRET_ACCESS_KEY=local-only-secret-key

# Destino dos eventos de saída e origem das operações consumidas.
AWS_EVENTS_QUEUE_URL=http://localstack:4566/000000000000/wager-events.fifo
AWS_TRANSACTIONS_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
AWS_TRANSACTIONS_DLQ_URL=http://localstack:4566/000000000000/wager-transactions-dlq.fifo

# Consumo da fila de operações. O long polling segura a chamada até 20s
# esperando mensagem, o que evita varredura em vazio sem aumentar a latência
# quando há trabalho.
WORKER_CONSUMER_INTERVAL=1s
WORKER_CONSUMER_BATCH=10
WORKER_CONSUMER_WAIT=20s

# Porta do listener de métricas. Separada da API de propósito: métrica revela
# volume de operação e taxa de recusa, e essa superfície não é a de negócio.
METRICS_PORT=9090
