# Munchkin — variáveis de ambiente locais de exemplo.
# Nenhum segredo real aqui. Copie para .env e ajuste:  cp .env.example .env
#
# Este arquivo cresce a cada checkpoint. Hoje cobre o CP-00/CP-01.

# --- Aplicação -------------------------------------------------------------
APP_ENV=local                  # local | test | production
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_REQUEST_TIMEOUT=10s       # deadline propagado no context de cada request
HTTP_SHUTDOWN_TIMEOUT=20s      # prazo para drenar requisições em andamento

# --- Observabilidade -------------------------------------------------------
LOG_LEVEL=info                 # debug | info | warn | error
LOG_FORMAT=json                # json em qualquer ambiente; text só para depurar à mão

# --- Autenticação (IdP externo OIDC) --------------------------------------
# AUTH_ISSUER é o valor esperado na claim `iss` do token. Obrigatório: sem ele
# a aplicação não sobe, porque um serviço que não sabe em qual IdP confiar
# aceitaria tráfego sem conseguir validar credencial.
AUTH_ISSUER=http://localhost:8180/realms/munchkin
AUTH_AUDIENCE=munchkin-api

# Quando a aplicação roda dentro da rede do compose, ela alcança o Keycloak
# por um endereço interno, enquanto o token continua sendo emitido com o
# endereço público. Nesse caso, aponte a descoberta para o endereço interno:
# AUTH_DISCOVERY_URL=http://keycloak:8080/realms/munchkin/.well-known/openid-configuration
AUTH_DISCOVERY_URL=

# Período do ticker que acompanha rotação programada de chave.
AUTH_JWKS_REFRESH_INTERVAL=15m
# Intervalo mínimo entre atualizações forçadas por `kid` desconhecido. Protege
# o IdP de uma enxurrada de tokens forjados com kid aleatório.
AUTH_JWKS_MIN_REFRESH_INTERVAL=1m
AUTH_HTTP_TIMEOUT=5s

# --- Keycloak (apenas ambiente local) --------------------------------------
KEYCLOAK_PORT=8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
